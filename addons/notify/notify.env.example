# Settings for the notify add-on: push notifications from the sandbox. Keep this file
# at mode 600. The agent can read the token (it sends the messages): use one that can
# only publish to this channel.
#
# The gateway allowlists NOTIFY_URL's host by itself and lets NOTIFY_PRIVATE_IP through
# the block on private ranges.

# ntfy | gotify | discord | slack | webhook
NOTIFY_SERVICE=ntfy
# ntfy:    server + topic, e.g. https://ntfy.sh/my-secret-topic
# gotify:  server base URL, e.g. https://gotify.example.org
# discord, slack: the incoming webhook URL
# webhook: any URL; gets a JSON POST {"title","message","priority"}
NOTIFY_URL=https://ntfy.example.org/agent-sandbox
# ntfy access token (tk_...), gotify application token, or a bearer token for
# webhook. Empty for public ntfy topics, discord and slack.
NOTIFY_TOKEN=
# The server's address if it is on your LAN or tailnet (e.g. 100.x.y.z), space or comma
# separated. Leave empty for public hosts.
NOTIFY_PRIVATE_IP=
# Claude Code events that send a notification automatically, space separated:
#   notification  Claude needs you (permission prompt, or waiting for input for a minute)
#   stop          Claude finished a turn
# Empty: none (Claude can still run `notify` itself).
NOTIFY_EVENTS=notification
# Title of automatic notifications (the project folder is appended)
NOTIFY_TITLE=Claude Code
