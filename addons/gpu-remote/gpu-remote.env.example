# Settings for the gpu-remote add-on (visible to the agent: no secrets).
# The gateway allowlists GPU_HOST by itself (it reads this file too).
GPU_HOST=gpu-server.example.org
# The server's address if it is on your LAN or tailnet (private range)
#GPU_PRIVATE_IP=
GPU_USER=youruser
GPU_PROJECT=default
# GPU_PORT=22
