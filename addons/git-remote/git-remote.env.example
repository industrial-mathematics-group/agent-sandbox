# Settings for the git-remote add-on: one Git hosting account the agent may use over
# HTTPS (push, pull, API). Keep this file at mode 600.
#
# The agent can read the token (it has to use it). Give it a fine-grained token that
# only covers the repositories it should work on, see addons/git-remote/README.md.
#
# The gateway allowlists GIT_REMOTE_HOST (and GIT_REMOTE_API_URL's host) by itself and
# lets GIT_REMOTE_PRIVATE_IP through the block on private ranges.

# github | forgejo (also Gitea) | gitlab
GIT_REMOTE_SERVICE=forgejo
# Host name only, without https://
GIT_REMOTE_HOST=git.example.org
# Personal access token
GIT_REMOTE_TOKEN=
# Account name for git over HTTPS. Required for forgejo; github and gitlab default to
# x-access-token / oauth2.
GIT_REMOTE_USER=
# The host's address if it is on your LAN or tailnet (e.g. 100.x.y.z), space or comma
# separated. Leave empty for public hosts.
GIT_REMOTE_PRIVATE_IP=
# Commit identity inside the sandbox (optional)
GIT_REMOTE_AUTHOR_NAME=
GIT_REMOTE_AUTHOR_EMAIL=
# API base URL, only if it differs from the service default
# (github.com: https://api.github.com, GitHub Enterprise: https://HOST/api/v3,
#  forgejo: https://HOST/api/v1, gitlab: https://HOST/api/v4)
#GIT_REMOTE_API_URL=
