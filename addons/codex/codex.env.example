# Settings for the codex add-on. Contains no secrets: your Codex login lives in the
# mounted ~/.codex folder (auth.json), not here.
#
# The gateway reads this file too and allowlists every *_HOST value, so a sandbox
# without this add-on can't reach OpenAI at all.

# Codex version installed at start: latest or an exact version (0.167.2).
# "latest" is re-checked at most once a day; an exact version is downloaded once.
CODEX_VERSION=latest

# Codex's own sandbox. The container and the gateway already isolate it, and Codex's
# bubblewrap/Landlock sandbox can't run in a rootless container, so the default is
# danger-full-access (inside the container). workspace-write / read-only only work if
# your host allows it. ~/.codex/config.toml (sandbox_mode) overrides this.
CODEX_SANDBOX_MODE=danger-full-access

# Hosts Codex needs: API (API key), ChatGPT login and backend, downloads (the npm
# registry: Codex is installed from @openai/codex's platform package)
CODEX_API_HOST=api.openai.com
CODEX_LOGIN_HOST=auth.openai.com chatgpt.com
CODEX_DOWNLOAD_HOST=registry.npmjs.org
