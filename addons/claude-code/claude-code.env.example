# Settings for the claude-code add-on. Contains no secrets: your Claude login lives in
# the mounted ~/.claude folder, not here.
#
# The gateway reads this file too and allowlists every *_HOST value, so a sandbox
# without this add-on can't reach Anthropic at all.

# Claude Code version installed at start: stable, latest or an exact version (2.1.30).
# A channel is re-checked at most once a day; an exact version is downloaded once.
CLAUDE_CODE_VERSION=stable

# Hosts Claude Code needs: API, login (Pro/Max OAuth, Console), downloads
CLAUDE_CODE_API_HOST=api.anthropic.com
CLAUDE_CODE_LOGIN_HOST=claude.ai console.anthropic.com platform.claude.com
CLAUDE_CODE_DOWNLOAD_HOST=downloads.claude.ai
