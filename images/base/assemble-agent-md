#!/bin/bash
# Builds /etc/agent-sandbox/AGENTS.md, the notes that tell the coding agent about
# this environment, from the fragments each image layer ships
# (/usr/share/agent-sandbox/claude-md/NN-name.md, sorted by name) and the fragments
# of mounted add-ons (/opt/agent-sandbox/addons/*/claude.md).
#
# Root-owned, so the agent can't edit it, and outside the agents' config folders,
# so it always matches the image and the active add-ons. The agent add-ons hand it
# to their CLI: claude-code copies it to the managed /etc/claude-code/CLAUDE.md
# (loaded in every session, can't be excluded), codex puts it into
# /etc/codex/config.toml as developer_instructions.
set -euo pipefail

out=${1:-/etc/agent-sandbox/AGENTS.md}
# Add-on mounts belong to the host user (= agent) and are usually mode 0700; the
# entrypoint's root has no CAP_DAC_OVERRIDE, so it reads them as agent.
read_addon() {
    cat "$1" 2>/dev/null && return 0
    [ "$(id -u)" = 0 ] && id agent >/dev/null 2>&1 || return 1
    setpriv --reuid=agent --regid=agent --init-groups --inh-caps=-all -- cat "$1" 2>/dev/null
}

tmp=$(mktemp)
{
    first=1
    for f in /usr/share/agent-sandbox/claude-md/*.md; do
        [ -r "$f" ] || continue
        [ "$first" = 1 ] || printf '\n'
        cat "$f"
        first=0
    done
    for d in /opt/agent-sandbox/addons/*/; do
        [ -d "$d" ] || continue
        frag=$(read_addon "${d}claude.md") || continue
        [ "$first" = 1 ] || printf '\n'
        printf '%s\n' "$frag"
        first=0
    done
} > "$tmp"
install -d -m 0755 "$(dirname "$out")"
install -m 0644 "$tmp" "$out"
rm -f "$tmp"
