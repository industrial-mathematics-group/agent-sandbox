# agent-sandbox base: Debian trixie + shell tooling + entrypoint. No language
# runtimes and no coding agent: runtimes come from the language images (see
# build.sh for the chains), the agent CLIs (Claude Code, Codex) from add-ons that
# install them at container start (addons/claude-code, addons/codex).
#
# No sudo and no firewall tools on purpose: the network is owned and filtered by
# the gateway sidecar (gateway/), whose network namespace this container joins.
ARG DEBIAN_IMAGE=docker.io/library/debian:trixie-slim
FROM ${DEBIAN_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# Build-time only (ARG, not ENV): no debconf prompts during apt
ARG DEBIAN_FRONTEND=noninteractive

# build-essential + pkg-config: native modules (node-gyp), Python sdists, Julia
# packages that compile at build time. netcat-openbsd: SSH through the gateway proxy.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl wget gnupg less procps man-db \
      git git-delta gh openssh-client netcat-openbsd util-linux \
      zsh fzf nano vim-tiny jq unzip xz-utils zstd \
      iproute2 bind9-dnsutils tzdata locales \
      build-essential pkg-config \
    && sed -i 's/^# *\(en_US.UTF-8\)/\1/' /etc/locale.gen && locale-gen \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Unprivileged user. uid/gid 1000 so files in /workspace match the usual first
# host user (Docker) or the host sandbox user via keep-id (Podman). ~/.claude and
# ~/.codex are only mount points for the agent add-ons: agent-owned, so a new named
# volume mounted there belongs to agent too.
RUN groupadd -g 1000 agent \
 && useradd -m -u 1000 -g 1000 -s /bin/zsh agent \
 && mkdir -p /workspace /commandhistory /home/agent/.claude /home/agent/.codex /home/agent/.local/bin \
 && touch /commandhistory/.zsh_history \
 && chown -R agent:agent /workspace /commandhistory /home/agent

# The proxy variables (HTTPS_PROXY=127.0.0.1:3128 -> gateway) are set only in the
# final images/final step: set here, they would break every later build step.
ENV LANG=en_US.UTF-8 \
    TZ=Etc/UTC \
    DEVCONTAINER=true \
    AGENT_SANDBOX=1 \
    SHELL=/bin/zsh \
    EDITOR=nano \
    VISUAL=nano \
    PATH=/home/agent/.local/bin:/opt/agent-sandbox/bin:$PATH

# SSH (git over ssh, the gpu/slurm add-ons) also goes through the proxy.
RUN printf '%s\n' \
      '# agent-sandbox: all traffic leaves through the gateway proxy' \
      'Host *' \
      '    ProxyCommand nc -X connect -x 127.0.0.1:3128 %h %p' \
      > /etc/ssh/ssh_config.d/50-agent-sandbox-proxy.conf

WORKDIR /workspace

# Shell: plain zsh config + delta as git pager (no framework download)
COPY --chown=agent:agent --chmod=0644 zshrc /home/agent/.zshrc
RUN git config --file /home/agent/.gitconfig core.pager delta \
 && git config --file /home/agent/.gitconfig interactive.diffFilter 'delta --color-only' \
 && chown agent:agent /home/agent/.gitconfig

# Entrypoint + hooks. Layers add their own hooks to entrypoint.d (e.g. Xvfb) and
# their instruction fragments to claude-md/; the entrypoint assembles them into
# /etc/agent-sandbox/AGENTS.md, which the agent add-ons hand to their CLI.
COPY --chmod=0755 entrypoint.sh /usr/local/bin/entrypoint.sh
COPY --chmod=0755 assemble-agent-md /usr/local/bin/
RUN install -d -m 0755 /usr/local/lib/agent-sandbox/entrypoint.d \
                       /usr/share/agent-sandbox/claude-md /opt/agent-sandbox/addons /opt/agent-sandbox/bin \
                       /etc/agent-sandbox
COPY --chmod=0644 claude-md/ /usr/share/agent-sandbox/claude-md/

LABEL org.opencontainers.image.title="agent-sandbox base" \
      org.opencontainers.image.description="Sandboxed container for coding agents such as Claude Code or Codex: base layer"

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["zsh"]
