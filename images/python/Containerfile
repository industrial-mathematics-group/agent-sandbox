# Python via uv (interpreters, venvs, packages). The system python3 is only there
# for build scripts that expect it; projects use uv-managed environments.
# uv is copied from its official image (global ARG + named stage = portable
# COPY --from for Podman/Buildah and Docker).
ARG UV_VERSION=latest
ARG BASE=localhost/agent-sandbox-stage:base
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM ${BASE}
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-dev python3-venv \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /usr/local/bin/
RUN uv --version

# ~/.cache (uv packages) and ~/.local/share/uv (uv-managed Pythons) are meant to
# be named volumes so wheels and interpreters survive image updates.
ENV UV_CACHE_DIR=/home/agent/.cache/uv \
    UV_PYTHON_INSTALL_DIR=/home/agent/.local/share/uv/python \
    UV_LINK_MODE=copy \
    UV_NATIVE_TLS=1
RUN install -d -o agent -g agent /home/agent/.cache /home/agent/.local /home/agent/.local/share /home/agent/.local/share/uv

COPY --chmod=0644 claude-md/ /usr/share/agent-sandbox/claude-md/
