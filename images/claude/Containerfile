# Final step of every published image: Claude Code (native CLI) on top of a
# language/layer chain, plus the default managed CLAUDE.md.
#
# Kept as the last step so a new Claude Code release only rebuilds one thin layer
# per image. The binary is installed root-owned to /usr/local/bin with the
# auto-updater off: the agent can't replace its own binary, and updates come
# with the image (weekly CI rebuild + podman auto-update / docker pull).
ARG BASE=localhost/agent-sandbox-stage:base
FROM ${BASE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
USER root

# "stable", "latest" or an exact version (CI passes the exact version so the
# cache is busted exactly when a new release exists).
ARG CLAUDE_CODE_VERSION=stable
RUN tmp=$(mktemp -d) \
 && curl -fsSL https://claude.ai/install.sh -o "$tmp/install.sh" \
 && HOME="$tmp" bash "$tmp/install.sh" "$CLAUDE_CODE_VERSION" \
 && install -m 0755 "$(readlink -f "$tmp/.local/bin/claude")" /usr/local/bin/claude \
 && rm -rf "$tmp" \
 && claude --version

# Runtime network: the gateway runs a filtering HTTP(S) proxy on 127.0.0.1:3128
# inside the shared network namespace. Direct connections are blocked, so every
# tool has to go through it. NODE_USE_ENV_PROXY makes Node's built-in fetch honour
# it. Set at the end on purpose: a later RUN step that downloads would go to the proxy.
ENV HTTP_PROXY=http://127.0.0.1:3128 \
    HTTPS_PROXY=http://127.0.0.1:3128 \
    http_proxy=http://127.0.0.1:3128 \
    https_proxy=http://127.0.0.1:3128 \
    NO_PROXY=localhost,127.0.0.1,::1 \
    no_proxy=localhost,127.0.0.1,::1 \
    NODE_USE_ENV_PROXY=1

ENV DISABLE_AUTOUPDATER=1 \
    CLAUDE_CONFIG_DIR=/home/agent/.claude \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# Default managed CLAUDE.md (regenerated at start to include mounted add-ons).
RUN /usr/local/bin/assemble-claude-md \
 && runuser -u agent -- test -r /etc/claude-code/CLAUDE.md \
 && runuser -u agent -- test ! -w /etc/claude-code/CLAUDE.md

ARG FLAVOR=custom
LABEL org.opencontainers.image.title="agent-sandbox ${FLAVOR}" \
      org.opencontainers.image.description="Sandboxed container for Claude Code (${FLAVOR})" \
      io.github.agent-sandbox.flavor="${FLAVOR}"
