# General add-on layer: headless Chromium + the shared libraries Playwright's own
# browsers and Electron need. For screenshots, browser tests, Playwright,
# Electron.jl (WGLMakie's test suite). Works on top of any language image.
#
# No GPU: WebGL runs on SwiftShader, which recent Chromium only enables with
# --enable-unsafe-swiftshader. Rootless containers lack the userns setup
# Chromium's sandbox wants, hence --no-sandbox. Debian's chromium wrapper sources
# /etc/chromium.d/*; Playwright/Electron need the same flags passed explicitly.
ARG BASE=localhost/agent-sandbox-stage:base
FROM ${BASE}
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium fonts-liberation fonts-noto-color-emoji \
      libnss3 libatk1.0-0t64 libatk-bridge2.0-0t64 libcups2t64 libdrm2 libgbm1 \
      libgtk-3-0t64 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
      libxkbcommon0 libasound2t64 libxss1 libxshmfence1 \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
 && printf '%s\n' \
      'export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --no-sandbox --headless=new --use-angle=swiftshader --enable-unsafe-swiftshader"' \
      > /etc/chromium.d/container \
 && chromium --version

# Playwright: keep its downloaded browsers in the persistent ~/.cache volume, or
# use the system Chromium (executablePath: '/usr/bin/chromium').
ENV PLAYWRIGHT_BROWSERS_PATH=/home/agent/.cache/ms-playwright \
    CHROME_PATH=/usr/bin/chromium
RUN install -d -o agent -g agent /home/agent/.cache

COPY --chmod=0644 claude-md/ /usr/share/agent-sandbox/claude-md/
