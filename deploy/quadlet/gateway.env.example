# Gateway settings for this instance (only the gateway reads this file, mode 600).

# standard: allowlist enforced by hostname in the proxy (default)
# strict:   + direct access to the allowlist's IPs, for tools that ignore proxies
# open:     every public host, LAN still blocked
GATEWAY_MODE=standard

# Allowlists to load besides base: node, python, julia, octave (see gateway/lists/)
GATEWAY_PROFILES=@PROFILES@

# More allowed hosts, space or comma separated ("*.example.com" = with subdomains).
# Longer lists: extra.list next to this file.
GATEWAY_EXTRA_DOMAINS=

# Regional Julia package server (also allowlisted automatically)
#JULIA_PKG_SERVER=https://eu-central.pkg.julialang.org

# TCP ports reachable from outside (published ports, or the tailnet with Tailscale)
GATEWAY_INBOUND_PORTS=@INBOUND_PORTS@

# Private addresses the gateway may still reach (LAN, tailnet: 100.x), space or comma
# separated, e.g. your own services. The host must also be allowlisted above.
GATEWAY_PRIVATE_ALLOW=

# Chain to an existing HTTP proxy (corporate networks), host:port
#GATEWAY_UPSTREAM_PROXY=proxy.example.org:3128

# --- Tailscale (only with --net tailscale) ---------------------------------
# Auth key (tag it, e.g. tag:agent-sandbox, to restrict the sandbox with ACLs)
#TS_AUTHKEY=tskey-auth-...
# The exit node's Tailscale IPv4 (`tailscale ip -4` on it), not a hostname
#TS_EXIT_NODE=100.x.y.z
# Must be unique per sandbox
#TS_HOSTNAME=@NAME@
