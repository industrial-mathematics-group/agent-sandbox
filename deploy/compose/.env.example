# Compose settings for one sandbox (copy to .env, or one file per project with --env-file).
SANDBOX_NAME=agent
REGISTRY=ghcr.io/OWNER
# minimal node node-chromium python python-gui julia julia-gui octave octave-gui full full-rocm
FLAVOR=full
# Compose files to use, so plain `docker compose up -d` works (":" separated).
# Add ../../addons/codex/compose.yaml for Codex, compose.podman.yaml for rootless Podman.
COMPOSE_FILE=compose.yaml:../../addons/claude-code/compose.yaml
# Claude login/settings: the shared named volume "claude" (default) or a host folder
#CLAUDE_CONFIG=/srv/claude/config
# Codex home (config.toml, auth.json): a host folder (default ./codex) or "codex-home"
#CODEX_CONFIG=./codex
# Host folder mounted as /workspace
WORKSPACE=./workspace
# Dev-server port published on 127.0.0.1 (and opened in the gateway firewall)
PORT_1=3000
PORTS=3000
MEMORY=16g
# CPU limit (at most the host's CPU count, `nproc`); 0 = no limit
CPUS=4
