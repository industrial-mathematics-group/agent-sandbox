# Compose settings for one sandbox (copy to .env, or one file per project with --env-file).
SANDBOX_NAME=agent
REGISTRY=ghcr.io/OWNER
# minimal node node-chromium python python-gui julia julia-gui octave octave-gui full full-rocm
FLAVOR=full
# Host folder mounted as /workspace
WORKSPACE=./workspace
# Dev-server port published on 127.0.0.1 (and opened in the gateway firewall)
PORT_1=3000
PORTS=3000
MEMORY=16g
CPUS=8
