# Agent container settings for this instance.
# Everything in here is visible to the agent. No secrets.

TZ=Etc/UTC
# Claude Code version installed at start: stable, latest or e.g. 2.1.30
CLAUDE_CODE_VERSION=stable
# Julia
JULIA_NUM_THREADS=auto
#JULIA_PKG_SERVER=https://eu-central.pkg.julialang.org
# Virtual display (images with the xvfb layer)
VIRTUAL_DISPLAY=1
XVFB_RESOLUTION=1920x1080x24
